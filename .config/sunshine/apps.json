{
    "apps": [
        {
            "image-path": "desktop.png",
            "name": "Desktop"
        },
        {
            "image-path": "desktop.png",
            "name": "Low Res Desktop",
            "prep-cmd": [
                {
                    "do": "xrandr --output HDMI-1 --mode 1920x1080",
                    "undo": "xrandr --output HDMI-1 --mode 1920x1200"
                }
            ]
        },
        {
            "auto-detach": true,
            "detached": [
                "setsid steam steam://open/bigpicture"
            ],
            "exclude-global-prep-cmd": false,
            "exit-timeout": 5,
            "image-path": "steam.png",
            "name": "Steam Big Picture",
            "output": "",
            "prep-cmd": [
                {
                    "do": "/home/daniel/.config/sunshine/sunshine_start.sh",
                    "undo": "/home/daniel/.config/sunshine/sunshine_stop.sh"
                }
            ],
            "wait-all": true
        },
        {
            "auto-detach": true,
            "cmd": "setsid steam steam://open/bigpicture",
            "elevated": false,
            "exclude-global-prep-cmd": false,
            "exit-timeout": 5,
            "image-path": "",
            "name": "Steam Big Picture 1080p",
            "output": "",
            "prep-cmd": [
                {
                    "do": "/home/daniel/.config/sunshine/sunshine_start1080p.sh",
                    "undo": "/home/daniel/.config/sunshine/sunshine_stop1080p.sh"
                }
            ],
            "wait-all": true
        }
    ],
    "env": {
        "PATH": "$(PATH):$(HOME)/.local/bin"
    }
}