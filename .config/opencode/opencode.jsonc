{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "provider": {
    "Ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
	"gemma4:e2b": {
          "name": "Gemma 4 E2B",
          "tools": true
        },
	"qwen3.5:0.8b": {
	  "name": "Qwen 3.5 0.8B",
          "tools": true
	},
	"qwen3.5:2b": {
          "name": "Qwen 3.5 2B",
          "tools": true
        },
	"qwen3.5:4b": {
          "name": "Qwen 3.5 4B",
          "tools": true
        }
      }
    }
  }
}
